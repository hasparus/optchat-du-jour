{
  "name": "optchat-du-jour",
  "description": "an endless chat whose history is its memory, kept as a binary summary tree",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.2",
  "scripts": {
    "postinstall": "bun --filter '@hasparus/oxlint-config' build",
    "build": "tsc -p . && bun --filter optchat-web build",
    "lint": "oxlint --deny-warnings --disable-nested-config",
    "test": "bun test --pass-with-no-tests && bun --filter '@hasparus/oxlint-config' test && bun --filter optchat-web test",
    "kernel": "cd kernel && bend kernel.bend -o kernel.mjs",
    "proofs": "cd kernel && bend PROOF.bend",
    "parity": "bun test/parity/run.ts"
  },
  "devDependencies": {
    "@hasparus/oxlint-config": "workspace:*",
    "@oxlint/plugins": "1.78.0",
    "@types/bun": "1.4.2",
    "eslint-plugin-better-tailwindcss": "4.0.2",
    "eslint-plugin-perfectionist": "5.4.0",
    "eslint-plugin-sonarjs": "4.2.0",
    "oxlint": "1.86.0",
    "oxlint-tsgolint": "7.0.2003",
    "typescript": "5.9.3"
  },
  "workspaces": [
    "vendor/*",
    "web"
  ],
  "dependencies": {
    "@ag-ui/core": "1.0.1",
    "@effect/platform-bun": "4.0.0",
    "effect": "4.0.1"
  },
  "bin": {
    "optchat": "cli/optchat.ts"
  }
}
